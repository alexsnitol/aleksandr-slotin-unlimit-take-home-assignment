# Docker Compose Environment Variables
# Copy this file to .env and modify values as needed

# MongoDB
MONGO_PORT=27017
MONGO_DB_NAME=issue_analyzer

# Ollama
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODEL=gemma4:e4b

# Spring Boot Application
APP_PORT=8080
SPRING_APPLICATION_NAME=issue-analyzer
SPRING_AI_OLLAMA_BASE_URL=http://ollama:11434
SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=gemma4:e4b
SPRING_AI_OLLAMA_CHAT_OPTIONS_TEMPERATURE=0.4
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/issue_analyzer
SERVER_PORT=8080

